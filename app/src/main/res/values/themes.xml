<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Leelo" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/accent_on</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/accent_on</item>

        <item name="android:colorBackground">@color/paper</item>
        <item name="colorOnBackground">@color/ink</item>
        <item name="colorSurface">@color/paper</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/paper</item>
        <item name="colorOnSurfaceVariant">@color/ink_muted</item>
        <item name="colorOutline">@color/line</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="colorPrimaryContainer">@color/paper</item>
        <item name="colorSecondaryContainer">@color/paper</item>

        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowBackground">@color/paper</item>

        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.Leelo" parent="Base.Theme.Leelo" />

    <style name="Theme.Leelo.NoActionBar" parent="Theme.Leelo">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Reading chrome is either visible or gone; never animated for more than 120ms. -->
    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/fade_in</item>
        <item name="android:windowExitAnimation">@anim/fade_out</item>
    </style>

    <style name="Widget.Leelo.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">6dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Leelo.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">6dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="BottomNavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="TextAppearance.Leelo.Nav" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/bottom_nav_colors</item>
    </style>

    <style name="BottomNavigationStyle" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/paper</item>
        <item name="android:elevation">0dp</item>
        <item name="itemIconTint">@color/bottom_nav_colors</item>
        <item name="itemTextColor">@color/bottom_nav_colors</item>
        <item name="itemIconSize">20dp</item>
        <item name="itemActiveIndicatorStyle">@style/BottomNavActiveIndicator</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Leelo.Nav</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Leelo.Nav</item>
    </style>
</resources>
