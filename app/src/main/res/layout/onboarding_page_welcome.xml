<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <TextView
        android:id="@+id/welcomeEyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LECTURA EN INGLÉS · A1–C1"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/pageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="serif"
        android:text="Bienvenido a Leelo"
        android:textColor="?attr/colorOnSurface"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/pageBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingMultiplier="1.6"
        android:text="Aprende inglés leyendo, sin fricción."
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="15sp" />

    <View
        android:id="@+id/welcomeRule"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:background="?attr/colorOutline" />

    <LinearLayout
        android:id="@+id/pageVisual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_word_dialog"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="Small "
            android:textColor="?attr/colorOnSurface"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="steps"
                android:textColor="?attr/colorOnSurface"
                android:textSize="17sp" />

            <View
                android:id="@+id/welcomeUnderline"
                android:layout_width="42dp"
                android:layout_height="1dp"
                android:layout_marginTop="2dp"
                android:background="?attr/colorPrimary" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text=", every day."
            android:textColor="?attr/colorOnSurface"
            android:textSize="17sp" />
    </LinearLayout>

</LinearLayout>
